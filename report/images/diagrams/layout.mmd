%% BusLens dashboard layout — three-column shell.
%% Render with:  mmdc -i layout.mmd -o layout.png -w 1400 -H 600 -b transparent

flowchart LR
  STRIP["<b>Icon strip · 52 px</b><br/>--<br/>🌐 Network<br/>📍 Route<br/>🚏 Stop<br/>💰 Finance<br/>🚇 Metro<br/>💬 Ask<br/>--<br/>☀ / 🌙 theme"]

  PANEL["<b>Analysis panel · 360 px</b><br/>--<br/>Filter strip<br/>(date · day-type · routes)<br/>--<br/>Lens header<br/>KPI grid (2 × 3)<br/>--<br/>Canvas selector<br/>(map / chart 1 / chart 2 / …)<br/>--<br/>Lists + drill-downs"]

  CANVAS["<b>Canvas · remainder of viewport</b><br/>--<br/>Default: pydeck map<br/>(stops coloured by demand)<br/>↕<br/>One chart at a time<br/>(swap on click in selector)<br/>--<br/>Always ≥ 60 % of screen"]

  STRIP --> PANEL --> CANVAS

  classDef col fill:#f8fafc,stroke:#64748b,color:#0f172a,stroke-width:1px;
  class STRIP,PANEL,CANVAS col
