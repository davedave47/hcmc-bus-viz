%% BusLens data schema.
%% Render with:  mmdc -i schema.mmd -o schema.png -w 1600 -H 1100 -b transparent
%%
%% Three groups: GPS side (left), AFC side (centre), shared masters (right).
%% Subgraphs keep groups visually separated so labels never overlap.

flowchart LR

  %% ============ GPS SIDE ============
  subgraph GPS["GPS · 2025-03-18 sample (9 routes)"]
    direction TB
    GR["gps_raw<br/><i>vehicle, datetime,<br/>lat, lng, speed,<br/>door_up/down</i>"]
    GT["gps_trips<br/><i>trip_id PK, route_id FK,<br/>vehicle_id FK,<br/>start/end_time,<br/>travel_time</i>"]
    GST["gps_stop_times<br/><i>trip_id FK, station_id FK,<br/>arrival, dwell, departure,<br/>order</i>"]
    GE["gps_extracted<br/><i>HMM-filtered ping<br/>in_buffer, hmm_state,<br/>nearest_stop_id</i>"]
    GSCH["gps_schedules<br/><i>route_id, direction,<br/>departure_time,<br/>arrival_time</i>"]
    GROU["gps_routes<br/><i>route_id PK, route_no,<br/>distance, headway,<br/>company_id FK</i>"]
    GSTA["gps_stations<br/><i>station_id PK,<br/>name, lat, lng,<br/>type, zone</i>"]
    GVH["gps_vehicles · gps_companies<br/>gps_drivers"]
  end

  %% ============ AFC SIDE ============
  subgraph AFC["AFC · 2026-01 → 2026-03 (90 days, 17.9 M tickets)"]
    direction TB
    T["tickets<br/><i>ticket_id PK,<br/>trip_id FK, station_id FK,<br/>ticket_type,<br/>time_created_ticket</i>"]
    P["payments<br/><i>ticket_id PK,<br/>final_price,<br/>payment_method</i>"]
    TT["ticket_trips<br/><i>trip_id PK, route_id FK,<br/>direction, bus_id FK</i>"]
    TR["ticket_routes<br/><i>route_id PK,<br/>route_no,<br/>company_id FK</i>"]
    TS["ticket_stations<br/><i>station_id PK,<br/>station_name,<br/>lat, lng</i>"]
    TC["ticket_companies"]
    TBU["ticket_buses<br/><i>bus_id PK,<br/>vehicle_number,<br/>capacity</i>"]
    TRS["ticket_route_stops<br/><i>route_id, station_id,<br/>sequence</i>"]
  end

  %% ============ SHARED ============
  subgraph SHARED["Shared masters"]
    direction TB
    SM["stops_master<br/><i>stop_id, name, type,<br/>zone, ward,<br/>lat, lng, routes</i><br/>(4 710 HCMC stops)"]
    VRM["vehicle_route_mapping<br/><i>vehicle_hash → route_no</i>"]
  end

  %% Relationships within GPS
  GR  --> GT
  GT  --> GST
  GT  --> GE
  GT  --> GROU
  GROU --> GSCH
  GST --> GSTA
  GROU --> GVH

  %% Relationships within AFC
  T   --> P
  T   --> TT
  T   --> TS
  TT  --> TR
  TT  --> TBU
  TR  --> TC
  TR  --> TRS
  TRS --> TS

  %% Cross-side via shared masters (name match only — no time bridge)
  SM  -.-> GSTA
  SM  -.-> TS

  %% Style
  classDef gps    fill:#fff7ed,stroke:#fb923c,stroke-width:1px,color:#7c2d12;
  classDef afc    fill:#eff6ff,stroke:#3b82f6,stroke-width:1px,color:#1e3a8a;
  classDef shared fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#14532d;

  class GR,GT,GST,GE,GSCH,GROU,GSTA,GVH gps
  class T,P,TT,TR,TS,TC,TBU,TRS afc
  class SM,VRM shared
