    <mxCell id="h1" value="SOURCE SYSTEMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B6470;strokeColor=#5B6470;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="210" height="42" as="geometry"/></mxCell>
