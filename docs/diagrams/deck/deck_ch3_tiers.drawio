    <mxCell id="cap" value="Each tier refines the one before it: raw fidelity is preserved at the bottom, while the cost of a query is paid once, when the serving tier is built, not on every request." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6FB;strokeColor=none;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="312" width="1252" height="58" as="geometry"/></mxCell>
