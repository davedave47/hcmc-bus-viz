    <mxCell id="cap" value="One click is the single coordination rule: it opens a panel of small views about the selected entity. Filtering, zooming and re-encoding stay in the controls bar, so a click never carries two meanings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6FB;strokeColor=none;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="468" width="1094" height="52" as="geometry"/></mxCell>
