<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="afc" value="&lt;b&gt;AFC&amp;nbsp;&amp;nbsp;(demand)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6470&quot;&gt;route_no, route_name&lt;br&gt;boarding stop&lt;br&gt;fare class, payment&lt;br&gt;&lt;b&gt;Jan&amp;ndash;Mar 2026&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="130" as="geometry"/></mxCell>

    <mxCell id="gps" value="&lt;b&gt;GPS&amp;nbsp;&amp;nbsp;(supply)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6470&quot;&gt;route_no, route_name&lt;br&gt;nearest stop&lt;br&gt;position, trip state&lt;br&gt;&lt;b&gt;Mar 2025&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="280" height="130" as="geometry"/></mxCell>

    <mxCell id="key" value="&lt;b&gt;route_no&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6470&quot;&gt;the one shared key&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1F3A5F;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="450" y="135" width="180" height="60" as="geometry"/></mxCell>

    <mxCell id="ka" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="afc" target="key"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="kb" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#2E75B6;strokeWidth=2;" edge="1" parent="1" source="key" target="gps"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="nox" value="&lt;b&gt;no timestamp join&lt;/b&gt;,&amp;nbsp;the two windows are a year apart" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBECEA;strokeColor=#C0392B;fontColor=#C0392B;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="440" height="44" as="geometry"/></mxCell>

    <mxCell id="res" value="&lt;b&gt;Joined at route &amp;times; hour-of-day &amp;times; day-type&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E07B2B;strokeColor=#E07B2B;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="440" height="56" as="geometry"/></mxCell>
    <mxCell id="ra" style="endArrow=classic;html=1;strokeColor=#5B6470;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="nox" target="res"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="capbar" value="" style="rounded=0;fillColor=#E07B2B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="6" height="46" as="geometry"/></mxCell>
    <mxCell id="cap" value="Demand and supply share the route and the city's stops, but not the clock; they are combined at the aggregate profile of route by time-of-day by day-type." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6FB;strokeColor=none;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;align=left;spacingLeft=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="456" width="994" height="46" as="geometry"/></mxCell>
